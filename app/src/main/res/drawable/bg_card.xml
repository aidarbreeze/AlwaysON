<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded "grouped list" card used behind each settings group. Fill uses
     the theme palette so the same drawable works in light and dark modes. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/settings_card" />
    <corners android:radius="14dp" />
</shape>
