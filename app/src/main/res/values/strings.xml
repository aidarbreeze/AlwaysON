    <!-- StandBy -->
    <string name="section_standby">StandBy screen</string>
    <string name="preview_section">Live preview</string>
    <string name="preview_desc">Big clock, date, a month calendar and, when music plays, a compact player — in the style of iPhone StandBy. Black OLED background with burn-in protection.</string>
    <string name="btn_preview">Show StandBy now</string>

    <string name="auto_title">Show while charging</string>
    <string name="auto_summary">While the phone charges, keeps a dim clock on screen (desk-clock style) in both orientations. It never blocks normal use — a tap, the power/home button, waking the phone or picking it up returns you to the normal screen; it re-appears on the next charge session.</string>
    <string name="overlay_perm_required">The “display over other apps” permission is required.</string>
    <string name="overlay_perm_button">Grant permission</string>
    <string name="overlay_perm_granted">Permission granted</string>

    <string name="btn_open_dream">Also use as the system screen saver</string>
    <string name="dream_hint">Android only auto-starts a screen saver when idle and charging on some devices. If yours does, pick “AlwaysON StandBy” as the screen saver in the settings it opens.</string>

    <string name="media_listener_label">AlwaysON media</string>
    <string name="media_access_title">Show playing music</string>
    <string name="media_access_button">Grant notification access</string>
    <string name="media_access_hint">To show the player card for music from any app, Android needs “Notification access” for AlwaysON. Tap to open the system list, then turn AlwaysON on.</string>

    <!-- Messenger notifications page -->
    <string name="section_notifs">Notifications</string>
    <string name="notif_page_title">Messenger notifications (Telegram, Max)</string>
    <string name="notif_page_summary">A second StandBy page: swipe left/right to flip between the clock and a list of the latest Telegram and Max notifications, each with its time. Needs “Notification access” (see above). The StandBy screen steps aside while a call is up.</string>
    <string name="notif_max_label">Show at most</string>
    <string name="notif_header">Notifications</string>
    <string name="notif_empty">No notifications yet</string>

