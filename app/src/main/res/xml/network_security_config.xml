<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default configuration: enforce TLS 1.2+ and block cleartext traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust only system CA certificates (no user-installed CAs) -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Domain-specific configuration for Open-Meteo API -->
    <!-- Note: Certificate Pinning temporarily disabled for development -->
    <!-- To re-enable: add valid SHA-256 pins (44 base64 chars = 32 bytes) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.open-meteo.com</domain>
        <domain includeSubdomains="true">geocoding-api.open-meteo.com</domain>
        
        <!-- Enforce TLS 1.2 minimum -->
        <min-sdk-version value="26" />
    </domain-config>

    <!-- Domain-specific configuration for MOEX ISS API -->
    <!-- Note: Certificate Pinning temporarily disabled for development -->
    <!-- To re-enable: add valid SHA-256 pins (44 base64 chars = 32 bytes) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">iss.moex.com</domain>
        
        <min-sdk-version value="26" />
    </domain-config>
</network-security-config>
