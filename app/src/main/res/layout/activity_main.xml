<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== StandBy ===== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_standby" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/preview_desc"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:textColor="#DE000000" />

        <Button
            android:id="@+id/btnPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/btn_preview" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_title"
                    android:textSize="16sp"
                    android:textColor="#DE000000" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_summary"
                    android:textSize="13sp"
                    android:textColor="#8A000000" />
            </LinearLayout>
            <Switch
                android:id="@+id/autoSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/permStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:textSize="13sp"
            android:textColor="#CC000000"
            android:text="" />

        <Button
            android:id="@+id/btnGrantPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/overlay_perm_button"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnOpenDream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/btn_open_dream" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dream_hint"
            android:textSize="13sp"
            android:textColor="#8A000000" />

        <!-- ===== Now-playing access ===== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/media_access_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/media_access_hint"
            android:textSize="13sp"
            android:textColor="#8A000000"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/btnMediaAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/media_access_button" />

        <!-- ===== Appearance ===== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_appearance" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/brightness_label"
            android:textSize="15sp"
            android:textColor="#DE000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <SeekBar
                android:id="@+id/brightnessSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />
            <TextView
                android:id="@+id/brightnessValue"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textSize="14sp"
                android:text="100%" />
        </LinearLayout>

        <Switch
            android:id="@+id/use24Switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:text="@string/switch_24h"
            android:textSize="16sp"
            android:textColor="#DE000000" />

        <Switch
            android:id="@+id/secondsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/switch_seconds"
            android:textSize="16sp"
            android:textColor="#DE000000" />

        <Switch
            android:id="@+id/batterySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/switch_battery"
            android:textSize="16sp"
            android:textColor="#DE000000" />

        <!-- ===== Note ===== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/tech_note_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tech_note"
            android:textSize="13sp"
            android:textColor="#8A000000"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>
</ScrollView>
