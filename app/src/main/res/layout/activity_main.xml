<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== StandBy ===== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_standby" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/preview_desc"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:textColor="#DE000000" />

        <Button
            android:id="@+id/btnPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/btn_preview" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_title"
                    android:textSize="16sp"
                    android:textColor="#DE000000" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_summary"
                    android:textSize="13sp"
                    android:textColor="#8A000000" />
            </LinearLayout>
            <Switch
                android:id="@+id/autoSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/permStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:textSize="13sp"
            android:textColor="#CC000000"
            android:text="" />

        <Button
            android:id="@+id/btnGrantPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/overlay_perm_button"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnOpenDream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/btn_open_dream" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dream_hint"
            android:textSize="13sp"
            android:textColor="#8A000000" />

        <!-- ===== Now-playing access ===== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/media_access_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/media_access_hint"
            android:textSize="13sp"
            android:textColor="#8A000000"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/btnMediaAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/media_access_button" />

        <!-- ===== Appearance ===== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_appearance" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_brightness_title"
                    android:textSize="16sp"
                    android:textColor="#DE000000" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_brightness_summary"
                    android:textSize="13sp"
                    android:textColor="#8A000000" />
            </LinearLayout>
            <Switch
                android:id="@+id/autoBrightSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/brightness_label"
            android:textSize="15sp"
            android:textColor="#DE000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <SeekBar
                android:id="@+id/brightnessSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />
            <TextView
                android:id="@+id/brightnessValue"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textSize="14sp"
                android:text="100%" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/clock_style_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#DE000000" />

        <RadioGroup
            android:id="@+id/clockStyleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp">

            <RadioButton
                android:id="@+id/styleNormal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="@string/style_normal"
                android:textSize="15sp"
                android:textColor="#DE000000" />

            <RadioButton
                android:id="@+id/styleOutline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="@string/style_outline"
                android:textSize="15sp"
                android:textColor="#DE000000" />

            <RadioButton
                android:id="@+id/styleDots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="@string/style_dots"
                android:textSize="15sp"
                android:textColor="#DE000000" />

            <RadioButton
                android:id="@+id/styleFlip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="@string/style_flip"
                android:textSize="15sp"
                android:textColor="#DE000000" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/outlineThicknessRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/clock_thickness_label"
                android:textSize="15sp"
                android:textColor="#DE000000" />

            <SeekBar
                android:id="@+id/thicknessSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="29" />

            <TextView
                android:id="@+id/thicknessValue"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textSize="14sp"
                android:text="" />
        </LinearLayout>

        <Switch
            android:id="@+id/use24Switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:text="@string/switch_24h"
            android:textSize="16sp"
            android:textColor="#DE000000" />

        <Switch
            android:id="@+id/secondsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/switch_seconds"
            android:textSize="16sp"
            android:textColor="#DE000000" />

        <Switch
            android:id="@+id/batterySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/switch_battery"
            android:textSize="16sp"
            android:textColor="#DE000000" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/battery_probe_hint"
            android:textSize="13sp"
            android:textColor="#8A000000" />

        <Button
            android:id="@+id/btnBatteryProbe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/btn_battery_probe"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/batteryProbe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="#AA000000"
            android:visibility="gone"
            android:text="" />

        <!-- ===== Stocks panel ===== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/stocks_section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stocks_switch_title"
                    android:textSize="16sp"
                    android:textColor="#DE000000" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stocks_switch_summary"
                    android:textSize="13sp"
                    android:textColor="#8A000000" />
            </LinearLayout>
            <Switch
                android:id="@+id/stocksSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/stockInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/stock_ticker_label"
                android:textSize="15sp"
                android:textColor="#DE000000" />

            <EditText
                android:id="@+id/tickerInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/stock_ticker_hint"
                android:inputType="textCapCharacters"
                android:singleLine="true"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/stock_ref_label"
                android:textSize="15sp"
                android:textColor="#DE000000" />

            <EditText
                android:id="@+id/refInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/stock_ref_hint"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/stock_type_label"
                android:textSize="15sp"
                android:textColor="#DE000000" />

            <RadioGroup
                android:id="@+id/stockTypeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="2dp">

                <RadioButton
                    android:id="@+id/stockTypeLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="@string/stock_type_line"
                    android:textSize="15sp"
                    android:textColor="#DE000000" />

                <RadioButton
                    android:id="@+id/stockTypeCandles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="@string/stock_type_candles"
                    android:textSize="15sp"
                    android:textColor="#DE000000" />
            </RadioGroup>
        </LinearLayout>

        <!-- ===== Note ===== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/tech_note_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tech_note"
            android:textSize="13sp"
            android:textColor="#8A000000"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>
</ScrollView>
